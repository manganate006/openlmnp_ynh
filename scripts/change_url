#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# $domain and $path still hold the *old* values here: the core only updates the settings
# once this script has returned.
old_mail_from="$app@$domain"
app_url="https://${new_domain}${new_path%/}"

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progression "Updating NGINX web server configuration..."

ynh_config_change_url_nginx

#=================================================
# MODIFY A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration..."

# Only the URL is rewritten: .env also holds settings the admin is invited to edit
# (mail server, registration, telemetry), and regenerating the file would discard them.
ynh_write_var_in_file --file="$install_dir/.env" --key=APP_URL --value="$app_url"

# The sender address follows the domain only as long as nobody has customized it.
if [ "$(ynh_read_var_in_file --file="$install_dir/.env" --key=MAIL_FROM_ADDRESS)" = "$old_mail_from" ]; then
    ynh_write_var_in_file --file="$install_dir/.env" --key=MAIL_FROM_ADDRESS --value="$app@$new_domain"
fi

artisan optimize:clear
artisan view:cache

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Change of URL completed for $app"
