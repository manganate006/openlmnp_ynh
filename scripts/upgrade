#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

ynh_app_setting_set_default --key=php_upload_max_filesize --value=50M
ynh_app_setting_set_default --key=php_post_max_size --value=50M

# Older installs stored Laravel's application key in the app settings; .env is preserved
# across upgrades, so the key no longer needs to live anywhere else.
ynh_app_setting_delete --key=random_key

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Stop the scheduler for the duration of the upgrade: between the source replacement and the
# end of `composer install` there is no vendor/autoload.php, and cron fires every minute.
ynh_safe_rm "/etc/cron.d/$app"

# Fold the write-ahead log back into the database file before it is moved around.
ynh_exec_as_app sqlite3 "$install_dir/database/database.sqlite" "PRAGMA wal_checkpoint(TRUNCATE);"

# .env holds the application key and the admin's settings, storage/ the uploaded receipts,
# and database.sqlite the accounting itself.
# Only the database *file* is kept, never the whole database/ directory: that directory also
# holds database/migrations/, and preserving it would silently restore the previous version's
# migrations, leaving the schema behind the code with no error reported.
ynh_setup_source --dest_dir="$install_dir" --full_replace \
    --keep=".env storage database/database.sqlite database/database.sqlite-wal database/database.sqlite-shm"

chown -R "$app:www-data" "$install_dir"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

#=================================================
# INSTALL DEPENDENCIES AND BUILD ASSETS
#=================================================
ynh_script_progression "Upgrading $app's dependencies..."

# See the install script for why --no-scripts must not be added here.
ynh_composer_exec install --no-dev --prefer-dist --optimize-autoloader --no-interaction

# Before Vite: app.css scans storage/framework/views, which still holds the previous
# version's compiled templates at this point.
artisan optimize:clear

pushd "$install_dir"
    ynh_exec_as_app npm ci --no-audit --no-fund
    ynh_exec_as_app npm run build
popd

ynh_safe_rm "$install_dir/node_modules"

chown -R "$app:www-data" "$install_dir"
chmod 600 "$install_dir/.env"

#=================================================
# MIGRATE THE DATABASE
#=================================================
ynh_script_progression "Migrating $app's database..."

artisan migrate --force
# --full_replace wiped public/storage, which is not in the release tarball.
artisan storage:link
artisan view:cache

#=================================================
# SET UP THE CRON JOB
#=================================================
ynh_script_progression "Setting up the scheduler..."

ynh_config_add --template="cron" --destination="/etc/cron.d/$app"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
