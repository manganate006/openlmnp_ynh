APP_NAME=OpenLMNP
APP_ENV=production
APP_KEY=__RANDOM_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=__INSTALL_DIR__/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# The administrator account is created at install time. Set to "true" to open sign-up.
ALLOW_REGISTRATION=false

# Set MAIL_MAILER=smtp and fill MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD to send mail.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=__APP__@__DOMAIN__
MAIL_FROM_NAME=OpenLMNP

MCP_ENABLED=false

# Daily anonymous install counter (random id + version). Set to false to disable.
TELEMETRY_ENABLED=true

TRUSTED_PROXIES=127.0.0.1,::1
