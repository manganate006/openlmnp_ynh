APP_NAME=OpenLMNP
APP_ENV=production
APP_KEY=__RANDOM_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=__INSTALL_DIR__/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# The administrator account is created at install time. Set to "true" to open sign-up.
ALLOW_REGISTRATION=false

# Mail goes through the server's own postfix, which is why the system user is allowed to
# send. Replace with MAIL_MAILER=smtp and the MAIL_HOST/MAIL_PORT/MAIL_USERNAME/
# MAIL_PASSWORD settings to relay through an external provider instead.
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=__APP__@__DOMAIN__
MAIL_FROM_NAME=OpenLMNP

MCP_ENABLED=false

# Daily anonymous install counter: a random identifier and a version number, nothing else.
# Answered at install time.
TELEMETRY_ENABLED=__TELEMETRY__

# The application can update itself in place (rsync, composer, npm). Under YunoHost the
# files belong to the package manager, and composer and npm are not on the app user's PATH:
# an in-place update would stop halfway and leave the installation half overwritten.
UPDATE_SELF_APPLY=false
# What the app tells the user instead. Without it the message reads "run docker pull",
# which is wrong on a YunoHost server. Honoured from the release that follows 1.6.6;
# harmless before that, and it is already in place for installs that upgrade into it,
# since .env is preserved.
UPDATE_SELF_APPLY_HINT=Les mises à jour passent par YunoHost : « yunohost app upgrade __APP__ », ou depuis l'administration.

TRUSTED_PROXIES=127.0.0.1,::1
